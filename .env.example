# --- Database (Railway provides this automatically when you add a Postgres plugin) ---
DATABASE_URL=postgres://user:password@host:5432/railway

# --- Session / security ---
# Any long random string. Generate one at https://generate-secret.vercel.app/32
SESSION_SECRET=change-me-to-a-long-random-string

# --- First admin account (created automatically the first time the app boots) ---
ADMIN_EMAIL=nmd.dixon@gmail.com
ADMIN_PASSWORD=change-me-before-first-boot
ADMIN_NAME=Nancy Marie Dixon

# --- Outgoing email (same Private Email / Namecheap mailbox the website already uses) ---
PRIVATE_EMAIL_SMTP_HOST=mail.privateemail.com
PRIVATE_EMAIL_SMTP_PORT=465
PRIVATE_EMAIL_SMTP_SECURE=true
PRIVATE_EMAIL_SMTP_USER=hello@dicollectivellc.com
PRIVATE_EMAIL_SMTP_PASSWORD=change-me
PRIVATE_EMAIL_FROM="Divine Collective <hello@dicollectivellc.com>"

# --- Website <-> CRM connection ---
# Shared secret the dicollectivellc.com website sends in the x-api-key header
# when it reports a new contact, registration, or purchase to this CRM.
# Generate any long random string and put the SAME value in both places.
WEBSITE_WEBHOOK_API_KEY=change-me-to-a-long-random-string

# --- Public URL of this CRM (used to build links in emails) ---
APP_URL=https://crm.dicollectivellc.com
